# ── Voice (required for speech in/out) ────────────────────────────
# Get a free key at elevenlabs.io. It stays server-side — the browser
# never sees it.
ELEVENLABS_API_KEY=
# Any voice id from your account. Find them at /api/voices once running.
# This default is "George" — British, calm.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Runtime ───────────────────────────────────────────────────────
# Where Claude Code runs. User-scoped connectors work from anywhere.
JARVIS_WORKDIR=~

# bypass  = the assistant may use tools without asking (needed for
#           connectors to work headlessly — see the README)
# default = require approval (tools will stall in a headless run)
JARVIS_PERMISSION=bypass

# all  = load your Claude Code connectors (Gmail, Calendar, …)
# none = skip them, if one is hanging
JARVIS_MCP=all

# Kill a run that produces no output for this many seconds.
JARVIS_TIMEOUT=45

JARVIS_PORT=8730
